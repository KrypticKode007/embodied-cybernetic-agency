# ---------------------------------------------------------------- palette --
BG      = (10/255, 14/255, 26/255, 1)
PANEL   = (18/255, 24/255, 40/255, 1)
PANEL2  = (13/255, 19/255, 34/255, 1)
STROKE  = (140/255, 160/255, 210/255, .28)
TEXT    = (233/255, 237/255, 247/255, 1)
DIM     = (139/255, 147/255, 170/255, 1)
CYAN    = (76/255, 224/255, 210/255, 1)
VIOLET  = (139/255, 127/255, 255/255, 1)
AMBER   = (255/255, 214/255, 10/255, 1)
RED     = (255/255, 84/255, 112/255, 1)
GREEN   = (53/255, 224/255, 138/255, 1)

STATUS_COLOR = {'green': GREEN, 'amber': AMBER, 'red': RED}

# --------------------------------------------------------------- ranges ----
HEAT_MIN, HEAT_MAX = 15, 70   # deg C, cell temperature
COOL_MIN, COOL_MAX = 5, 55    # deg C, heatsink/coolant-loop temperature


def clamp(v, lo=0, hi=1):
    return max(lo, min(hi, v))


def frac(v, lo, hi):
    return clamp((v - lo) / (hi - lo), 0, 1)


def heat_class(c):
    return 'green' if c < 35 else ('amber' if c < 50 else 'red')


def cool_class(c):
    return 'green' if c < 25 else ('amber' if c < 40 else 'red')


def resist_class(v):
    return 'green' if v < 0.5 else ('amber' if v < 0.75 else 'red')


def c_to_f(c):
    return c * 9 / 5 + 32


def fmt_temp(c, unit):
    return f"{round(c_to_f(c))}°F" if unit == 'F' else f"{round(c)}°C"


def risk_index(resistance, heat_c, cool_c):
    return clamp(0.40 * frac(heat_c, HEAT_MIN, HEAT_MAX)
                 + 0.35 * resistance
                 + 0.25 * frac(cool_c, COOL_MIN, COOL_MAX))


# ------------------------------------------------------------- widgets -----
class Card(BoxLayout):
    """A rounded, bordered panel — used for every card/panel in the app."""

    def __init__(self, bg=PANEL, radius=16, **kw):
        super().__init__(**kw)
        self._bg = bg
        self._radius = dp(radius)
        with self.canvas.before:
            self._c = Color(*bg)
            self._rect = RoundedRectangle(radius=[self._radius], pos=self.pos, size=self.size)
            Color(*STROKE)
            self._line = Line(width=dp(1))
        self.bind(pos=self._update, size=self._update)
        self._update()

    def _update(self, *a):
        self._rect.pos = self.pos
        self._rect.size = self.size
        self._line.rounded_rectangle = (self.x, self.y, self.width, self.height, self._radius)


class StatusLight(Widget):
    status = StringProperty('green')

    def __init__(self, **kw):
        kw.setdefault('size_hint', (None, None))
        kw.setdefault('size', (dp(10), dp(10)))
        super().__init__(**kw)
        self.bind(pos=self._redraw, size=self._redraw, status=self._redraw)

    def _redraw(self, *a):
        self.canvas.clear()
        col = STATUS_COLOR[self.status]
        with self.canvas:
            Color(col[0], col[1], col[2], .35)
            Ellipse(pos=(self.x - dp(3), self.y - dp(3)), size=(self.width + dp(6), self.height + dp(6)))
            Color(*col)
            Ellipse(pos=self.pos, size=self.size)


class LiquidGauge(Widget):
    """Radial gauge: static green/yellow/red zone ring + glowing level ring."""
    level = NumericProperty(0)        # 0..1
    status = StringProperty('green')
    halo_alpha = NumericProperty(.16)

    def __init__(self, low_break=.5, high_break=.75, **kw):
        self.low_break = low_break
        self.high_break = high_break
        super().__init__(**kw)
        self.bind(pos=self._redraw, size=self._redraw, level=self._redraw,
                  status=self._redraw, halo_alpha=self._redraw)
        Clock.schedule_once(self._redraw, 0)
        pulse = (Animation(halo_alpha=.28, duration=1.3, t='in_out_sine')
                 + Animation(halo_alpha=.12, duration=1.3, t='in_out_sine'))
        pulse.repeat = True
        pulse.start(self)

    def set_level(self, value, animate=True):
        if animate:
            Animation.cancel_all(self, 'level')
            Animation(level=value, duration=1.0, t='out_quad').start(self)
        else:
            self.level = value

    def _redraw(self, *a):
        self.canvas.before.clear()
        self.canvas.clear()
        self.canvas.after.clear()
        if self.width < 4 or self.height < 4:
            return
        cx, cy = self.center_x, self.center_y
        R = min(self.width, self.height) / 2 - dp(2)
        outer_hole_r = R * 0.74
        level_r = R * 0.60
        level_hole_r = R * 0.40
        col = STATUS_COLOR[self.status]

        with self.canvas.before:
            Color(col[0], col[1], col[2], self.halo_alpha)
            Ellipse(pos=(cx - R - dp(10), cy - R - dp(10)), size=(2 * (R + dp(10)), 2 * (R + dp(10))))

        a_top = 90
        a_low = 90 - self.low_break * 360
        a_high = 90 - self.high_break * 360
        a_end = 90 - 360

        with self.canvas:
            Color(*PANEL2)
            Ellipse(pos=(cx - R, cy - R), size=(2 * R, 2 * R))

            Color(GREEN[0], GREEN[1], GREEN[2], .55)
            Ellipse(pos=(cx - R, cy - R), size=(2 * R, 2 * R), angle_start=a_low, angle_end=a_top)
            Color(AMBER[0], AMBER[1], AMBER[2], .55)
            Ellipse(pos=(cx - R, cy - R), size=(2 * R, 2 * R), angle_start=a_high, angle_end=a_low)
            Color(RED[0], RED[1], RED[2], .55)
            Ellipse(pos=(cx - R, cy - R), size=(2 * R, 2 * R), angle_start=a_end, angle_end=a_high)

            Color(*PANEL2)
            Ellipse(pos=(cx - outer_hole_r, cy - outer_hole_r), size=(2 * outer_hole_r, 2 * outer_hole_r))

            lvl_end = 90 - self.level * 360
            Color(col[0], col[1], col[2], 1)
            Ellipse(pos=(cx - level_r, cy - level_r), size=(2 * level_r, 2 * level_r),
                    angle_start=lvl_end, angle_end=a_top)

            Color(*PANEL2)
            Ellipse(pos=(cx - level_hole_r, cy - level_hole_r), size=(2 * level_hole_r, 2 * level_hole_r))

        with self.canvas.after:
            Color(*STROKE)
            Line(circle=(cx, cy, R), width=dp(1.2))
            Color(1, 1, 1, .32)
            for fr in (self.low_break, self.high_break):
                ang = math.radians(90 - fr * 360)
                x1, y1 = cx + outer_hole_r * math.cos(ang), cy + outer_hole_r * math.sin(ang)
                x2, y2 = cx + R * math.cos(ang), cy + R * math.sin(ang)
                Line(points=[x1, y1, x2, y2], width=dp(1.3))


def seg_toggle(options, default, on_change):
    """options: list of (key, label). Returns (row_widget, get_value_fn)."""
    row = BoxLayout(size_hint_y=None, height=dp(34), spacing=dp(3))
    buttons = {}

    def make_cb(key):
        def cb(instance):
            if instance.state == 'down':
                on_change(key)
        return cb

    for key, label in options:
        b = ToggleButton(text=label, group=id(row), state='down' if key == default else 'normal',
                          background_normal='', background_down='',
                          background_color=(CYAN[0], CYAN[1], CYAN[2], 1) if key == default else PANEL2,
                          color=(8/255, 16/255, 24/255, 1) if key == default else DIM,
                          font_size=dp(12.5), bold=True)
        b.bind(state=lambda inst, val, k=key: on_change(k) if val == 'down' else None)
        buttons[key] = b
        row.add_widget(b)

    def restyle(active_key):
        for k, b in buttons.items():
            active = k == active_key
            b.background_color = (CYAN[0], CYAN[1], CYAN[2], 1) if active else PANEL2
            b.color = (8/255, 16/255, 24/255, 1) if active else DIM

    return row, restyle


def desc_row(title, desc, right_widget):
    row = BoxLayout(size_hint_y=None, height=dp(58), spacing=dp(10), padding=(0, dp(6)))
    txt = BoxLayout(orientation='vertical')
    txt.add_widget(Label(text=title, color=TEXT, font_size=dp(14.5), bold=True,
                          size_hint_y=None, height=dp(20), halign='left', valign='bottom',
                          text_size=(dp(220), dp(20))))
    txt.add_widget(Label(text=desc, color=DIM, font_size=dp(11.5),
                          halign='left', valign='top', text_size=(dp(220), dp(34))))
    row.add_widget(txt)
    row.add_widget(right_widget)
    return row


